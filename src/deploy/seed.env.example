# Mẫu — copy thành deploy/seed.env (đã .gitignore) rồi điền giá trị thật.
# Dùng: make seed-prod DATABASE_URL="<chuỗi-Supabase>"
#
# Set SEED_EMAIL_1 → chế độ TÙY CHỈNH: 2 tài khoản CHUNG 1 hộ gia đình.
SEED_PASSWORD=<mật-khẩu-chung>
SEED_EMAIL_1=<email-1>
SEED_NAME_1=<tên-hiển-thị-1>
SEED_EMAIL_2=<email-2>
SEED_NAME_2=<tên-hiển-thị-2>
SEED_HOUSEHOLD=<tên-hộ>
