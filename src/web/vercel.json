{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://household-finance-api-4f3n3c6hpa-as.a.run.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
